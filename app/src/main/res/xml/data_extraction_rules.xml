<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trailtrack.xml" />   <!-- tokeny sesji i klucz serwera -->
        <exclude domain="file" path="osmdroid/" />               <!-- cache kafelków do 2 GB psuje limit kopii -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trailtrack.xml" />
        <exclude domain="file" path="osmdroid/" />
    </device-transfer>
</data-extraction-rules>
